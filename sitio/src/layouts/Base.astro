---
// Maqueta v4 «el portfolio que filtra» (30-sep-2026). Decisiones: NotionPilot 915cb423.
// noindex hasta publicar. Logo REAL (vectorizado con potrace de su web de 2018), nunca redibujado.
// Tipografías: Unbounded e Instrument Sans (OFL). Iconos: Lucide (ISC).
import '../styles/site.css';
import { taller, u, img } from '../data/site';
import logoDefs from '../data/logo_defs.html?raw';

interface Props {
  title: string;
  description: string;
  actual?: 'trabajos' | 'zona' | 'guias' | 'encargo';
  /** La portada necesita las capas del logo en línea (caja luminosa y banderola) */
  capasLogo?: boolean;
}
const { title, description, actual, capasLogo = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://digitorotulacion.com').href.replace('/digito-maqueta', '');
const cur = (k: string) => (actual === k ? { 'aria-current': 'page' } : {});
const schema = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness', '@id': 'https://digitorotulacion.com/#taller',
  name: taller.nombre, description: 'Taller de rótulos: diseño, fabricación y montaje desde 1993.',
  url: 'https://digitorotulacion.com/', telephone: taller.fijoTel, email: taller.email, foundingDate: '1993',
  address: { '@type': 'PostalAddress', streetAddress: `${taller.poligono}, ${taller.calle}`, postalCode: taller.cp, addressLocality: taller.localidad, addressRegion: taller.provincia, addressCountry: 'ES' },
  geo: { '@type': 'GeoCoordinates', latitude: 37.6642927, longitude: -4.9385672 },
};
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#323846">
<link rel="icon" href={img('logo-digito.svg')} type="image/svg+xml">
<link rel="preload" href={u('/fonts/unbounded-var-latin.woff2')} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={u('/fonts/instrument-var-latin.woff2')} as="font" type="font/woff2" crossorigin>
<style set:html={`@font-face{font-family:'Unbounded';font-weight:200 900;font-display:swap;src:url('${u('/fonts/unbounded-var-latin.woff2')}') format('woff2-variations')}@font-face{font-family:'Instrument Sans';font-weight:400 700;font-display:swap;src:url('${u('/fonts/instrument-var-latin.woff2')}') format('woff2-variations')}`}></style>
<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
{capasLogo && <defs set:html={logoDefs}></defs>}
<symbol id="i-tel" viewBox="0 0 24 24"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></symbol>
<symbol id="i-wa" viewBox="0 0 24 24"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/></symbol>
<symbol id="i-pin" viewBox="0 0 24 24"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></symbol>
<symbol id="i-reloj" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></symbol>
<symbol id="i-flecha" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></symbol>
<symbol id="i-camara" viewBox="0 0 24 24"><path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"/><circle cx="12" cy="13" r="3"/></symbol>
<symbol id="i-regla" viewBox="0 0 24 24"><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"/><path d="m14.5 12.5 2-2"/><path d="m11.5 9.5 2-2"/><path d="m8.5 6.5 2-2"/><path d="m17.5 15.5 2-2"/></symbol>
<symbol id="i-escalera" viewBox="0 0 24 24"><path d="M8 3v18"/><path d="M16 3v18"/><path d="M8 7h8"/><path d="M8 12h8"/><path d="M8 17h8"/></symbol>
<symbol id="i-casa" viewBox="0 0 24 24"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></symbol>
<symbol id="i-camion" viewBox="0 0 24 24"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></symbol>
<symbol id="i-bombilla" viewBox="0 0 24 24"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></symbol>
</svg>
<a class="salto" href="#contenido">Saltar al contenido</a>
<div class="propuesta">Propuesta de web en revisión (v4) · <a href={u('/v2/')}>ver la v2</a> · la web oficial sigue en <a href="https://digitorotulacion.com/">digitorotulacion.com</a></div>

<header class="cab">
  <div class="wrap">
    <a class="cab-logo" href={u('/')} aria-label="Dígito Rotulación, inicio"><img src={img('logo-digito.svg')} alt="Dígito Rotulación" width="216" height="108"></a>
    <nav aria-label="Principal">
      <a href={u('/trabajos/')} {...cur('trabajos')}>Trabajos</a>
      <a href={u('/#precio')}>Precios</a>
      <a href={u('/zona/')} {...cur('zona')}>Dónde montamos</a>
      <a href={u('/guias/permiso-rotulo-cordoba/')} {...cur('guias')}>Permisos</a>
    </nav>
    <a class="btn btn-luz" href={u('/encargo/')} aria-label="Pide presupuesto"><svg class="ico"><use href="#i-camara"/></svg><span>Pide presupuesto</span></a>
  </div>
</header>

<main id="contenido">
  <slot />
</main>

<footer class="pie">
  <div class="wrap">
    <div class="pie-rejilla">
      <div><img class="logo" src={img('logo-digito.svg')} alt="Dígito Rotulación" width="216" height="108" loading="lazy"><p>Taller de rótulos en La Carlota desde 1993. Lo diseñamos, lo fabricamos y te lo montamos.</p></div>
      <div><h2>El taller</h2><p>{taller.poligono}</p><p>{taller.calle}</p><p>{taller.cp} {taller.localidad} ({taller.provincia})</p><p>{taller.horario.corto} {taller.horario.pendiente && <span class="pend">a confirmar</span>}</p></div>
      <div><h2>Contacto</h2><p><a href={`tel:${taller.fijoTel}`}>{taller.fijo}</a></p><p><a href={`https://wa.me/${taller.whatsappNum}`}>{taller.whatsapp}</a> (WhatsApp)</p><p><a href={`mailto:${taller.email}`}>{taller.email}</a></p></div>
      <div><h2>La web</h2><ul><li><a href={u('/trabajos/')}>Trabajos</a></li><li><a href={u('/encargo/')}>Pide presupuesto</a></li><li><a href={u('/zona/')}>Dónde montamos</a></li><li><a href={u('/guias/permiso-rotulo-cordoba/')}>Permiso para un rótulo</a></li></ul></div>
    </div>
    <div class="legal"><span>© Dígito Rotulación</span><a href={u('/aviso-legal/')}>Aviso legal</a><a href={u('/privacidad/')}>Privacidad</a></div>
  </div>
</footer>
</body>
</html>
