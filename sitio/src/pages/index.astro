/* ================= MOVIMIENTO DE OFICIO =================
   La caja luminosa da dos parpadeos de tubo y se enciende; RÓTULOS se monta letra a letra;
   luego se cuelgan las piezas una a una y la banderola se enciende. Solo transform y opacity.
   Con movimiento reducido, todo montado y encendido. */
@media (prefers-reduced-motion:no-preference){
  .firma .apagado{animation:tubo 1.25s linear .35s backwards}
  .banderola .apagado{animation:tubo 1.25s linear calc(1.5s + .5s) backwards}
  @keyframes tubo{0%,22%{opacity:.8}24%{opacity:0}34%{opacity:.62}40%{opacity:0}50%,56%{opacity:.4}76%,100%{opacity:0}}
  .firma .halo{animation:aparece 1s ease-out 1.2s backwards}
  @keyframes aparece{from{opacity:0}}
  .corporeo .l{animation:monta .5s cubic-bezier(.34,1.56,.64,1) backwards;animation-delay:calc(.2s + var(--i) * .06s)}
  @keyframes monta{from{opacity:0;transform:translateY(-.3em)}}
  .tira{animation:aparece .5s ease-out .9s backwards}
  .pieza .obj{animation:cuelga .9s cubic-bezier(.3,.7,.3,1) backwards;animation-delay:calc(1.05s + var(--n) * .16s)}
  @keyframes cuelga{0%{opacity:0;transform:translateY(-1.4rem) rotate(-5deg)}45%{opacity:1;transform:translateY(0) rotate(2.2deg)}72%{transform:rotate(-.9deg)}100%{transform:none}}
  .pieza .etiqueta{animation:aparece .5s ease-out backwards;animation-delay:calc(1.6s + var(--n) * .16s)}
}
